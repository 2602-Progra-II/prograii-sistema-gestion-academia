erDiagram
%% Coincide con database/schema.sql (SQL Server)

    ROL {
        INT id_rol PK
        VARCHAR nombre_rol UK
        VARCHAR descripcion
    }
    USUARIO {
        INT id_usuario PK
        VARCHAR nombre
        VARCHAR apellido
        VARCHAR email UK "credencial de login"
        VARCHAR password
        INT id_rol FK
        BIT activo
    }
    PERIODO_ACADEMICO {
        INT id_periodo PK
        VARCHAR nombre_periodo
        DATE fecha_inicio
        DATE fecha_fin
        VARCHAR estado
    }
    CURSO {
        INT id_curso PK
        VARCHAR nombre_curso
        VARCHAR codigo_curso UK
        VARCHAR descripcion
        INT id_periodo FK
        VARCHAR estado
        INT id_instructor FK
    }
    MATRICULA {
        INT id_matricula PK
        DATE fecha_matricula
        VARCHAR estado_matricula
        VARCHAR id_estudiante "id del usuario"
        INT id_curso FK
    }
    MATERIAL_DIDACTICO {
        INT id_material PK
        VARCHAR titulo
        VARCHAR descripcion
        VARCHAR url_enlace
        INT id_curso FK
    }
    ACTIVIDAD_EVALUATIVA {
        INT id_actividad PK
        VARCHAR nombre_actividad
        VARCHAR descripcion
        DATE fecha_limite
        DECIMAL ponderacion
        INT id_curso FK
        VARCHAR tipo_actividad "TAREA, EXAMEN o PROYECTO"
    }
    ENTREGA_EVALUACION {
        INT id_entrega PK
        VARCHAR ruta_archivo_entrega
        DATE fecha_entrega
        DECIMAL calificacion
        VARCHAR observaciones
        INT id_actividad FK
        VARCHAR id_estudiante "id del usuario"
    }
    PAGO {
        INT id_pago PK
        DECIMAL monto
        DATE fecha_pago
        VARCHAR ruta_comprobante
        VARCHAR estado_pago
        VARCHAR id_estudiante "id del usuario"
        VARCHAR id_asesor_validador "id del usuario"
        INT id_matricula FK
    }
    FACTURA {
        INT id_factura PK
        VARCHAR numero_factura UK
        DATE fecha_emision
        DECIMAL monto_total
        INT id_pago FK
    }
    DETALLE_PAGO {
        INT id_detalle PK
        INT id_pago FK
        VARCHAR concepto
        DECIMAL subtotal
    }

    ROL ||--o{ USUARIO : asigna
    PERIODO_ACADEMICO ||--o{ CURSO : contiene
    USUARIO |o--o{ CURSO : imparte
    CURSO ||--o{ MATRICULA : recibe
    CURSO ||--o{ MATERIAL_DIDACTICO : contiene
    CURSO ||--o{ ACTIVIDAD_EVALUATIVA : contiene
    ACTIVIDAD_EVALUATIVA ||--o{ ENTREGA_EVALUACION : recibe
    MATRICULA |o--o{ PAGO : cubre
    PAGO |o--o| FACTURA : genera
    PAGO ||--o{ DETALLE_PAGO : detalla
