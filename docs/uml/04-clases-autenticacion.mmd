classDiagram
%% Autenticacion, usuarios y menu por rol

class LoginController {
    +iniciarSesion(String email, String contrasena) Optional~Sesion~
    +cerrarSesion(Sesion)
}

class AutenticacionService {
    <<interface>>
    +iniciarSesion(String email, String contrasena) Sesion
    +validarCredenciales(String email, String contrasena) boolean
    +cerrarSesion(int idSesion)
}

class AutenticacionServiceImpl {
    -Map~Integer, Sesion~ sesionesActivas
    -AtomicInteger secuencia
}

class UsuarioController {
    +registrar(Usuario)
    +activar(int)
    +desactivar(int)
    +asignarRol(int, Rol)
}

class UsuarioService {
    <<interface>>
    +registrar(Usuario)
    +modificar(Usuario)
    +activar(int)
    +desactivar(int)
    +asignarRol(int, Rol)
}
class UsuarioServiceImpl

class UsuarioRepository {
    <<interface>>
    +buscarPorEmail(String) Usuario
    +buscarPorId(int) Usuario
    +listarTodos() List~Usuario~
}
class UsuarioRepositoryImpl

class Sesion {
    -int idSesion
    -LocalDateTime fechaInicio
    -LocalDateTime fechaFin
    -boolean activa
    -Usuario usuario
}

class MenuPrincipal {
    +ejecutar()
    -login() Optional~Sesion~
    -menuSegunRol(Sesion)
}

class ModuloMenu {
    <<interface>>
    +ejecutar(Sesion)
}
class MenuUsuarios
class MenuPeriodosCursos
class MenuAcademico
class MenuReportes
class MenuCore

LoginController --> AutenticacionService
AutenticacionService <|.. AutenticacionServiceImpl
AutenticacionServiceImpl --> UsuarioRepository
AutenticacionServiceImpl ..> Sesion : crea
UsuarioController --> UsuarioService
UsuarioService <|.. UsuarioServiceImpl
UsuarioServiceImpl --> UsuarioRepository
UsuarioRepository <|.. UsuarioRepositoryImpl
Sesion --> Usuario

MenuPrincipal --> LoginController
MenuPrincipal --> ModuloMenu : segun el rol
ModuloMenu <|.. MenuUsuarios
ModuloMenu <|.. MenuPeriodosCursos
ModuloMenu <|.. MenuAcademico
ModuloMenu <|.. MenuReportes
MenuPrincipal ..> MenuCore : lambda ModuloMenu
