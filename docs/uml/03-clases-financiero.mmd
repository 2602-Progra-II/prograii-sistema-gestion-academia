classDiagram
%% Modulo financiero: flujo transaccional matricula -> pago -> factura, estado de cuenta y concurrencia

class MatriculaController {
    +matricularEstudiante(int, int, double) Optional~ResultadoMatricula~
    +aprobarPago(int, String) Optional~Factura~
    +rechazarPago(int, String) boolean
}

class FlujoMatriculaService {
    -DataSource dataSource
    +matricular(int, int, double) ResultadoMatricula
    +aprobarPago(int, String) Factura
    +rechazarPago(int, String)
    -enTransaccion(TrabajoTransaccional~T~) T
}

class TrabajoTransaccional~T~ {
    <<interface>>
    +ejecutar(Connection) T
}

class ResultadoMatricula {
    <<record>>
    +matricula() Matricula
    +pago() Pago
}

class EstadoCuentaService {
    +calcularDesdeBD(int) EstadoCuenta
    +calcularTodosDesdeBD() List~EstadoCuenta~
    +totalPagado(int) double
    +obtenerEstudiantesEnMora() List~EstadoCuenta~
}

class ReporteService {
    +generarIndicadorMora(List~EstadoCuenta~, String) IndicadorMora
}

class ProcesoConcurrenteService {
    -DataSource dataSource
    -int hilos
    +ejecutarCierreDeCartera() ResultadoCierreCartera
    +ejecutarProcesoConcurrente() ResultadoCierreCartera
}

class ResultadoCierreCartera {
    <<record>>
    +cuentas() List~EstadoCuenta~
    +totalPendiente() double
    +totalPagado() double
    +estudiantesEnMora() int
    +errores() int
}

class BusinessException
class TransaccionException
class PersistenciaException

class PagoRepository { <<interface>> }
class MatriculaRepository { <<interface>> }
class FacturaRepository { <<interface>> }
class UsuarioRepository { <<interface>> }

MatriculaController --> FlujoMatriculaService
FlujoMatriculaService --> MatriculaRepository
FlujoMatriculaService --> PagoRepository
FlujoMatriculaService --> FacturaRepository
FlujoMatriculaService --> UsuarioRepository
FlujoMatriculaService ..> TrabajoTransaccional
FlujoMatriculaService ..> ResultadoMatricula
FlujoMatriculaService ..> BusinessException : regla de negocio
FlujoMatriculaService ..> TransaccionException : error tecnico + rollback

EstadoCuentaService --> PagoRepository
EstadoCuentaService --> UsuarioRepository
ReporteService ..> EstadoCuenta
ReporteService ..> IndicadorMora

ProcesoConcurrenteService ..> ResultadoCierreCartera
ProcesoConcurrenteService ..> PersistenciaException
ProcesoConcurrenteService ..> EstadoCuenta
