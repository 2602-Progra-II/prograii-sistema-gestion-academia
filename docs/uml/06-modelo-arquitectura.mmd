%% Arquitectura por capas (version final). Las flechas indican dependencia.

    subgraph P["Presentación (consola) - sv.gestionacademica / menu"]
        MAIN["Main<br/>arma las dependencias"]
        MP["MenuPrincipal<br/>login + menú por rol"]
        MM["MenuCore · MenuUsuarios · MenuPeriodosCursos<br/>MenuAcademico · MenuReportes<br/>(interfaz ModuloMenu)"]
    end

    subgraph C["Controladores - controller"]
        CTRL["LoginController · UsuarioController<br/>MatriculaController · AcademicoController"]
    end

    subgraph S["Servicios / reglas de negocio - service"]
        SRV["AutenticacionService · UsuarioService · FlujoMatriculaService<br/>PeriodoAcademicoService · CursoService · MaterialService<br/>ActividadService · EvaluacionService · EstadoCuentaService<br/>ReporteService · ProcesoConcurrenteService"]
    end

    subgraph R["Acceso a datos - repository (interfaces + JDBC)"]
        REPO["*Repository (interfaces)<br/>*RepositoryImpl (PreparedStatement, ResultSet,<br/>try-with-resources)"]
    end

    subgraph I["Infraestructura - persistence"]
        DS["DataSourceConfig<br/>HikariCP (pool 10 conexiones)"]
    end

    DB[("SQL Server<br/>sistema_gestion_academia")]

    D["Dominio - entity / enums / dto / exception<br/>Usuario, Curso, ActividadEvaluativa (Tarea, Examen, Proyecto),<br/>Pago, Factura, EstadoCuenta... · BusinessException, TransaccionException, PersistenciaException"]

    MAIN --> MP --> MM --> CTRL --> SRV --> REPO --> DS --> DB
    SRV -- "FlujoMatriculaService: transacción (commit/rollback)<br/>ProcesoConcurrenteService: ExecutorService, 1 conexión por hilo" --> DS
    MM -. usa .-> D
    CTRL -. usa .-> D
    SRV -. usa .-> D
    REPO -. mapea .-> D
