}


namespace Persistencia {

    class UsuarioRepository {
        +guardar(usuario)
        +buscarPorId(id)
        +buscarPorNombreUsuario(nombre)
        +actualizar(usuario)
    }

    class RolRepository {
        +buscarPorId(id)
        +listar()
    }

    class CursoRepository {
        +guardar(curso)
        +buscarPorId(id)
        +listarPorPeriodo(idPeriodo)
    }

    class MatriculaRepository {
        +guardar(matricula)
        +listarPorEstudiante(idEstudiante)
        +listarPorCurso(idCurso)
    }

    class PagoRepository {
        +guardar(pago)
        +buscarPorId(id)
        +listarPendientes()
        +actualizar(pago)
    }

    class FacturaRepository {
        +guardar(factura)
        +listarPorEstudiante(idEstudiante)
    }

    class MaterialRepository {
        +guardar(material)
        +listarPorCurso(idCurso)
    }

    class ActividadRepository {
        +guardar(actividad)
        +listarPorCurso(idCurso)
    }

    class EntregaRepository {
        +guardar(entrega)
        +listarPorActividad(idActividad)
        +listarPorEstudiante(idEstudiante)
    }
}


