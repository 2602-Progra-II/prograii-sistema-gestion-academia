classDiagram

direction LR


namespace Presentacion {

    class LoginController {
        +iniciarSesion()
    }

    class UsuarioController {
        +registrarUsuario()
        +modificarUsuario()
        +activarUsuario()
        +desactivarUsuario()
        +asignarRol()
    }

    class AcademicoController {
        +registrarPeriodo()
        +registrarCurso()
        +asignarInstructor()
        +matricularEstudiante()
        +publicarMaterial()
        +crearActividad()
        +entregarActividad()
        +calificarActividad()
    }

    class FinancieroController {
        +registrarPago()
        +aprobarPago()
        +rechazarPago()
        +generarFactura()
        +consultarEstadoCuenta()
    }

    class ReporteController {
        +consultarRendimiento()
        +consultarMora()
        +consultarFacturacion()
    }
}


namespace Servicios {

    class AutenticacionService {
        +iniciarSesion(nombreUsuario, contrasena) Sesion
        +validarCredenciales(nombreUsuario, contrasena) boolean
        +cerrarSesion(sesion)
    }

    class UsuarioService {
        +registrarUsuario(usuario)
        +modificarUsuario(usuario)
        +activarUsuario(usuario)
        +desactivarUsuario(usuario)
        +asignarRol(usuario, rol)
    }

    class PeriodoAcademicoService {
        +registrarPeriodo(periodo)
        +modificarPeriodo(periodo)
        +activarPeriodo(periodo)
        +finalizarPeriodo(periodo)
    }

    class CursoService {
        +registrarCurso(curso)
        +asignarInstructor(curso, instructor)
        +consultarCurso(idCurso)
    }

    class MatriculaService {
        +matricular(estudiante, curso)
        +consultarMatricula(idMatricula)
    }

    class MaterialService {
        +publicarMaterial(material, instructor)
        +consultarMaterial(curso, estudiante)
        +descargarMaterial(material, estudiante)
    }

    class ActividadService {
        +crearActividad(actividad, instructor)
        +consultarActividades(estudiante, curso)
    }

    class EvaluacionService {
        +entregarActividad(entrega, estudiante)
        +calificarActividad(entrega, instructor)
        +consultarCalificaciones(estudiante, curso)
    }

    class PagoService {
        +registrarPago(pago, estudiante)
        +aprobarPago(pago, asesor)
        +rechazarPago(pago, asesor)
    }

    class FacturaService {
        +generarFactura(pagoValidado, asistente)
        +consultarFacturas(estudiante)
        +consultarDetalle(factura)
    }

    class EstadoCuentaService {
        +calcularSaldo(estudiante)
        +verificarMora(estudiante) boolean
    }

    class ReporteService {
        +calcularRendimiento(curso)
        +consultarEstudiantesMora(filtros)
        +calcularIndicadoresMora(filtros)
        +consultarHistorialFacturacion(estudiante)
    }
}


namespace Dominio {

    class Usuario
    class Rol
    class Sesion
    class PeriodoAcademico
    class Curso
    class Matricula
    class MaterialDidactico
    class ActividadEvaluativa
    class EntregaEvaluacion
    class Pago
    class Factura
    class EstadoCuenta
