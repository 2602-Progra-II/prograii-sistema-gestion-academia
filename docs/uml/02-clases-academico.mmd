classDiagram
%% Modulo academico: periodos, cursos, material, actividades (herencia) y evaluaciones

class AcademicoController {
    +registrarPeriodo(PeriodoAcademico) PeriodoAcademico
    +activarPeriodo(int) PeriodoAcademico
    +finalizarPeriodo(int) PeriodoAcademico
    +registrarCurso(Curso) Curso
    +asignarInstructor(int, int) Curso
    +publicarMaterial(Usuario, int, String, String, String) MaterialDidactico
    +crearActividad(Usuario, int, TipoActividad, String, String, LocalDate, double) ActividadEvaluativa
    +entregarActividad(Usuario, int, String) EntregaEvaluacion
    +calificarActividad(Usuario, int, double, String) EntregaEvaluacion
    +consultarCalificaciones(Usuario) List~EntregaEvaluacion~
    +cursosDelEstudiante(Usuario) List~Curso~
    -exigirInstructorDelCurso(Usuario, Curso)
}

class PeriodoAcademicoService
class CursoService
class MaterialService
class ActividadService
class EvaluacionService {
    +entregarActividad(EntregaEvaluacion, Usuario) EntregaEvaluacion
    +calificarActividad(EntregaEvaluacion, Usuario)
    +buscarEntrega(int) Optional~EntregaEvaluacion~
    +listarEntregasDeActividad(int) List~EntregaEvaluacion~
}

class ActividadEvaluativa {
    <<abstract>>
    +calcularNotaFinal(double)* double
    +calcularNotaFinal(double, LocalDate) double
    +permiteEntregaTardia() boolean
    +getTipo() TipoActividad
    +calcularAporte(double) double
    +estaVencidaPara(LocalDate) boolean
}
class Tarea {
    +calcularNotaFinal(double, LocalDate) double  -20% si es tarde
    +permiteEntregaTardia() boolean  true
}
class Examen {
    +calcularNotaFinal(double) double
    +estaAprobado(double) boolean
}
class Proyecto {
    +calcularNotaFinal(double, LocalDate) double  +5% a tiempo
}
class TipoActividad {
    <<enumeration>>
    TAREA
    EXAMEN
    PROYECTO
    +crear(int, String, String, LocalDate, double)* ActividadEvaluativa
    +desdeTexto(String)$ TipoActividad
}

class ActividadRepository {
    <<interface>>
}
class ActividadRepositoryImpl
class MaterialRepository {
    <<interface>>
}
class EntregaRepository {
    <<interface>>
}
class MatriculaRepository {
    <<interface>>
}

AcademicoController --> PeriodoAcademicoService
AcademicoController --> CursoService
AcademicoController --> MaterialService
AcademicoController --> ActividadService
AcademicoController --> EvaluacionService
AcademicoController --> MatriculaRepository : valida matricula ACTIVA
AcademicoController ..> TipoActividad : crea por tipo

ActividadService --> ActividadRepository
MaterialService --> MaterialRepository
EvaluacionService --> EntregaRepository
ActividadRepository <|.. ActividadRepositoryImpl
ActividadRepositoryImpl ..> TipoActividad : mapea tipo_actividad

ActividadEvaluativa <|-- Tarea
ActividadEvaluativa <|-- Examen
ActividadEvaluativa <|-- Proyecto
TipoActividad ..> Tarea
TipoActividad ..> Examen
TipoActividad ..> Proyecto
