classDiagram
%% Modelo de dominio (paquete sv.gestionacademica.entity y enums) - version final Entrega 3

class Identificable~ID~ {
    <<interface>>
    +getId() ID
}

class Usuario {
    -int idUsuario
    -String nombreUsuario
    -String apellidoUsuario
    -String email
    -String contrasena
    -EstadoUsuario estado
}

class Rol {
    -int idRol
    -String nombreRol
    -String descripcion
}

class Sesion {
    -int idSesion
    -LocalDateTime fechaInicio
    -LocalDateTime fechaFin
    -boolean activa
    +estaActiva() boolean
}

class PeriodoAcademico {
    -int idPeriodo
    -String nombrePeriodo
    -LocalDate fechaInicio
    -LocalDate fechaFin
    -EstadoPeriodo estado
    +fechasValidas() boolean
    +estaVigente() boolean
    +renombrar(String)
    +cambiarEstado(EstadoPeriodo)
}

class Curso {
    -int idCurso
    -String codigoCurso
    -String nombreCurso
    -String descripcion
    -EstadoCurso estado
    -int idPeriodo
    -Integer idInstructor
    +activar()
    +desactivar()
    +asignarInstructor(int)
}

class Matricula {
    -int idMatricula
    -LocalDate fechaMatricula
    -EstadoMatricula estadoMatricula
}

class Pago {
    -int idPago
    -double monto
    -LocalDate fechaPago
    -String rutaComprobante
    -EstadoPago estadoPago
    -String idEstudiante
    -String idAsesorValidador
    -Integer idMatricula
    +estaPendiente() boolean
    +estaAprobado() boolean
    +estaRechazado() boolean
}

class Factura {
    -int idFactura
    -String numeroFactura
    -LocalDate fechaEmision
    -double montoTotal
    -Integer idPago
}

class MaterialDidactico {
    -String id
    -String titulo
    -String descripcion
    -String urlEnlace
    -int idCurso
}

class ActividadEvaluativa {
    <<abstract>>
    -String id
    -String nombre
    -double ponderacion
    -String fechaEntrega
    -int idCurso
    +calcularNotaFinal(double)* double
    +calcularNotaFinal(double, LocalDate) double
    +permiteEntregaTardia() boolean
    +getTipo() TipoActividad
    +calcularAporte(double) double
    +estaVencida() boolean
}

class Tarea
class Examen {
    +estaAprobado(double) boolean
}
class Proyecto

class EntregaEvaluacion {
    -int idEntrega
    -String rutaArchivoEntrega
    -LocalDate fechaEntrega
    -double calificacion
    -String observaciones
    -int idActividad
    -String idEstudiante
    +estaCalificada() boolean
}

class EstadoCuenta {
    -String idEstudiante
    -String nombreEstudiante
    -double saldoPendiente
    -boolean enMora
}

class IndicadorMora {
    -int totalEstudiantesEnMora
    -double montoTotalPendiente
    -String periodoAcademico
}

class EstadoUsuario { <<enumeration>>
    ACTIVO
    INACTIVO }
class EstadoPeriodo { <<enumeration>>
    PLANIFICADO
    ACTIVO
    FINALIZADO
    +puedeTransicionarA(EstadoPeriodo)* boolean }
class EstadoCurso { <<enumeration>>
    INACTIVO
    ACTIVO
    +puedeTransicionarA(EstadoCurso)* boolean }
class EstadoMatricula { <<enumeration>>
    PENDIENTE_PAGO
    ACTIVA
    CANCELADA }
class EstadoPago { <<enumeration>>
    PENDIENTE
    APROBADO
    RECHAZADO }
class TipoActividad { <<enumeration>>
    TAREA
    EXAMEN
    PROYECTO
    +crear(...)* ActividadEvaluativa }

Identificable <|.. MaterialDidactico
Identificable <|.. ActividadEvaluativa
ActividadEvaluativa <|-- Tarea
ActividadEvaluativa <|-- Examen
ActividadEvaluativa <|-- Proyecto
TipoActividad ..> ActividadEvaluativa : crea

Usuario "0..*" --> "1" Rol : tiene
Sesion "0..*" --> "1" Usuario : de
PeriodoAcademico "1" <-- "0..*" Curso : pertenece
Usuario "0..1" <-- "0..*" Curso : instructor
Matricula "0..*" --> "1" Usuario : estudiante
Matricula "0..*" --> "1" Curso : curso
Pago "0..1" --> "0..1" Matricula : cubre
Factura "0..1" --> "1" Pago : origina
Curso "1" *-- "0..*" MaterialDidactico
Curso "1" *-- "0..*" ActividadEvaluativa
ActividadEvaluativa "1" *-- "0..*" EntregaEvaluacion
IndicadorMora ..> EstadoCuenta : resume

Usuario --> EstadoUsuario
PeriodoAcademico --> EstadoPeriodo
Curso --> EstadoCurso
Matricula --> EstadoMatricula
Pago --> EstadoPago
